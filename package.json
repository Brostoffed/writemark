{
  "name": "writemark-editor",
  "version": "1.8.0",
  "description": "Writemark is a dependency-free live inline Markdown editor web component with slash commands, smart editing, form integration, source fallback, and no built-in toolbar.",
  "type": "module",
  "main": "./dist/writemark-editor.js",
  "module": "./dist/writemark-editor.js",
  "exports": {
    ".": {
      "types": "./dist/writemark-editor.d.ts",
      "default": "./dist/writemark-editor.js"
    },
    "./writemark-editor.js": {
      "types": "./dist/writemark-editor.d.ts",
      "default": "./dist/writemark-editor.js"
    },
    "./writemark-editor.global.js": {
      "types": "./dist/writemark-editor.global.d.ts",
      "default": "./dist/writemark-editor.global.js"
    },
    "./md-live-editor.js": {
      "types": "./dist/md-live-editor.d.ts",
      "default": "./dist/md-live-editor.js"
    },
    "./writemark-editor.global.min.js": {
      "types": "./dist/writemark-editor.global.min.d.ts",
      "default": "./dist/writemark-editor.global.min.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "web-component",
    "markdown",
    "editor",
    "custom-elements",
    "slash-commands",
    "live-preview"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brostoffed/writemark.git"
  },
  "bugs": {
    "url": "https://github.com/Brostoffed/writemark/issues"
  },
  "homepage": "https://github.com/Brostoffed/writemark#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "capture:demo-gif": "node scripts/capture-demo-gif.mjs",
    "start": "node scripts/dev-server.mjs --open=demo/index.html",
    "start:lan": "node scripts/dev-server.mjs --host=0.0.0.0 --open=demo/index.html",
    "serve": "node scripts/dev-server.mjs",
    "serve:lan": "node scripts/dev-server.mjs --host=0.0.0.0",
    "test": "npm run check && npm run test:browser",
    "test:browser": "playwright test",
    "test:browser:chromium": "playwright test --project=chromium",
    "test:browser:headed": "playwright test --project=chromium --headed",
    "test:server": "node --test tests/dev-server.test.mjs",
    "test:version": "node --test tests/version-policy.test.mjs",
    "test:fuzz": "npm run check && playwright test tests/security.spec.js --project=chromium",
    "check:version": "node scripts/check-version.mjs",
    "perf": "node scripts/dev-server.mjs --open=perf/index.html",
    "prepack": "npm run check",
    "check": "node scripts/build.mjs --check && node scripts/check-source.mjs && npm run check:version && npm run test:version && npm run test:server && npm run test:unit && npm run test:build && npm run test:types && node scripts/check-docs.mjs",
    "check:build": "node scripts/build.mjs --check",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:build": "node --test tests/build.test.mjs",
    "test:types": "node scripts/check-types.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "commonmark": "0.31.2",
    "esbuild": "0.28.2",
    "fast-check": "4.9.0",
    "typescript": "6.0.3"
  },
  "types": "./dist/writemark-editor.d.ts"
}
