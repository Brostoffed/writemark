{
  "name": "writemark-editor",
  "version": "1.2.2",
  "description": "Writemark is a dependency-free live inline Markdown editor web component with slash commands, smart editing, form integration, source fallback, and no built-in toolbar.",
  "type": "module",
  "main": "./dist/writemark-editor.js",
  "module": "./dist/writemark-editor.js",
  "exports": {
    ".": "./dist/writemark-editor.js",
    "./writemark-editor.js": "./dist/writemark-editor.js",
    "./writemark-editor.global.js": "./dist/writemark-editor.global.js",
    "./md-live-editor.js": "./dist/md-live-editor.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "web-component",
    "markdown",
    "editor",
    "custom-elements",
    "slash-commands",
    "live-preview"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brostoffed/writemark.git"
  },
  "bugs": {
    "url": "https://github.com/Brostoffed/writemark/issues"
  },
  "homepage": "https://github.com/Brostoffed/writemark#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/dev-server.mjs --open=demo/index.html",
    "serve": "node scripts/dev-server.mjs",
    "test": "npm run check && npm run test:browser",
    "test:browser": "playwright test",
    "test:browser:chromium": "playwright test --project=chromium",
    "test:browser:headed": "playwright test --project=chromium --headed",
    "perf": "node scripts/dev-server.mjs --open=perf/index.html",
    "prepack": "npm run build && npm run check",
    "check": "node scripts/build.mjs --check && node --check src/writemark-editor.js && node --check dist/writemark-editor.js && node --check dist/writemark-editor.global.js && node --check scripts/dev-server.mjs && node --check scripts/build.mjs && node --check scripts/check-docs.mjs && node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
